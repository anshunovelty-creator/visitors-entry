# Copy to .env.local and fill in from Supabase: Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Email via Resend (resend.com). Without a key, emails print to the terminal in development.
RESEND_API_KEY=
# Sender once your domain is verified in Resend, e.g. Novelty Labels Visitors <visitors@noveltylabels.com>
EMAIL_FROM=
