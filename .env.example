# Copy to .env.local and fill in from Supabase: Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Email over SMTP. Without SMTP_HOST, emails print to the terminal in development.
# Gmail / Google Workspace: smtp.gmail.com, port 587, your address, and an app password
# (Google Account > Security > App passwords; needs 2-step verification).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional sender, e.g. Novelty Labels Visitors <visitors@noveltylabels.com>. Defaults to SMTP_USER.
EMAIL_FROM=
# Optional: signs the host's Approve / Decline links. Defaults to the service-role key.
HOST_LINK_SECRET=
# Push notifications to staff phones: generate with `npx web-push generate-vapid-keys`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
